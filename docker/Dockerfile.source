# Syntax=docker/dockerfile:1
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    libsm6 libxext6 ffmpeg libfontconfig1 libxrender1 libgl1-mesa-glx \
    curl git python3-pip python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Upgrade pip
RUN pip3 install --no-cache-dir --upgrade pip

# Install PyTorch and XFormers (pre-built wheels for CUDA)
# Note: Adjust cuda version in URL if necessary to match base image
RUN pip3 install --no-cache-dir torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu118
RUN pip3 install --no-cache-dir xformers==0.0.23.post1 --index-url https://download.pytorch.org/whl/cu118

# Copy requirements first to leverage cache
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Install IOPaint from source
RUN pip3 install --no-cache-dir .

# Expose port
EXPOSE 8080

# Environment variables
ENV IOPAINT_model=lama
ENV IOPAINT_device=cuda
ENV IOPAINT_port=8080
ENV IOPAINT_host=0.0.0.0

# Entrypoint
CMD ["iopaint", "start", "--model", "lama", "--device", "cuda", "--port", "8080", "--host", "0.0.0.0"]
